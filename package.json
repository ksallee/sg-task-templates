{
	"name": "sg-task-templates",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Apply a task template to Shots and Assets without duplicating existing Tasks, built on sg-widgets.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
