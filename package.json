		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"sg-widgets-core": "^0.1.0",
		"tailwind-merge": "^3.7.0",
